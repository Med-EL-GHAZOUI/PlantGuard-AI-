# Copiez ce fichier en `.env` (ignoré par Git) et adaptez. Aucune valeur ici n'est un secret.
# Variables lues par le backend (voir backend/app/config.py) :
PLANTGUARD_MODEL_DIR=ml/artifacts/final
PLANTGUARD_DATABASE_URL=sqlite:///backend/plantguard.db
PLANTGUARD_UPLOAD_DIR=backend/uploads
PLANTGUARD_MAX_UPLOAD_MB=5
PLANTGUARD_RATE_LIMIT_PER_MINUTE=30
PLANTGUARD_ENABLE_DOCS=1
PLANTGUARD_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Variables lues par docker-compose.yml :
# MODEL_DIR=./ml/artifacts/final
# FRONTEND_PORT=8080
# ENABLE_DOCS=0
