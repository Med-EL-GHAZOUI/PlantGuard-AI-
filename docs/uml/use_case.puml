@startuml use_case
left to right direction
actor "Utilisateur" as U
actor "Développeur" as D
rectangle "PlantGuard AI" {
  usecase "Téléverser une image" as UC1
  usecase "Prévisualiser l'image" as UC2
  usecase "Analyser la feuille" as UC3
  usecase "Consulter le résultat" as UC4
  usecase "Consulter infos maladie" as UC5
  usecase "Consulter l'historique" as UC6
  usecase "Supprimer une analyse" as UC7
  usecase "Consulter le dashboard" as UC8
  usecase "Valider le fichier" as UC9
  usecase "Entraîner / mettre à jour le modèle" as UC10
}
U --> UC1
U --> UC3
U --> UC4
U --> UC6
U --> UC7
U --> UC8
D --> UC10
UC1 ..> UC2 : <<include>>
UC1 ..> UC9 : <<include>>
UC3 ..> UC9 : <<include>>
UC4 ..> UC5 : <<extend>>
@enduml
